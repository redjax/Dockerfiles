{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        ":dependencyDashboard"
    ],
    "enabledManagers": [
        "github-actions",
        "dockerfile",
        "custom.regex"
    ],
    "ignorePaths": [
        "**/package.json",
        "**/requirements.txt",
        "**/pyproject.toml",
        "**/go.mod",
        "**/Cargo.toml"
    ],
    "hostRules": [
        {
            "hostType": "docker",
            "matchHost": "docker.io",
            "username": "{{ secrets.DOCKERHUB_USERNAME }}",
            "password": "{{ secrets.DOCKERHUB_TOKEN }}"
        }
    ],
    "platformAutomerge": true,
    "packageRules": [
        {
            "description": "GitHub workflow updates only",
            "matchManagers": [
                "github-actions"
            ],
            "matchFileNames": [
                ".github/workflows/**"
            ]
        },
        {
            "description": "Docker image tag updates",
            "matchDatasources": [
                "docker"
            ],
            "versioning": "docker"
        },
        {
            "description": "Automerge Docker image updates",
            "matchDatasources": [
                "docker"
            ],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true,
            "automergeStrategy": "auto"
        },
        {
            "description": "Automerge GitHub Actions updates",
            "matchManagers": [
                "github-actions"
            ],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true,
            "automergeStrategy": "auto"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Dockerfile ARG version variables annotated with renovate comments",
            "managerFilePatterns": [
                "/(^|/)Dockerfile$/",
                "/(^|/)Dockerfile\\.[^/]*$/",
                "/^dockerfiles/.*/Dockerfile$/"
            ],
            "matchStrings": [
                "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?(?:\\s+extractVersion=(?<extractVersion>[^\\n]+))?\\s*\\nARG\\s+(?<argName>[A-Z0-9_]+)=(?<currentValue>[^\\s]+)"
            ],
            "datasourceTemplate": "{{datasource}}",
            "depNameTemplate": "{{depName}}",
            "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}docker{{/if}}",
            "extractVersionTemplate": "{{extractVersion}}"
        },
        {
            "customType": "regex",
            "description": "image.yml upstream version for Docker images",
            "managerFilePatterns": [
                "/^dockerfiles/.*/image.yml$/"
            ],
            "matchStrings": [
                "upstream:\\s*\\n[\\s\\S]*?registry:\\s*(?<registry>docker)[\\s\\S]*?name:\\s*(?<depName>[^\\n]+)[\\s\\S]*?version:\\s*(?<currentValue>[^\\n]+)"
            ],
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        }
    ]
}