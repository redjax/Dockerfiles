{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        ":dependencyDashboard"
    ],
    "enabledManagers": [
        "github-actions",
        "dockerfile",
        "custom.regex"
    ],
    "platformAutomerge": true,
    "packageRules": [
        {
            "description": "GitHub workflow updates only",
            "matchManagers": [
                "github-actions"
            ],
            "matchFileNames": [
                ".github/workflows/**"
            ]
        },
        {
            "description": "Docker image tag updates",
            "matchDatasources": [
                "docker"
            ],
            "versioning": "docker"
        },
        {
            "description": "Automerge all dependency updates",
            "matchPackageNames": [
                "*"
            ],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true,
            "automergeStrategy": "auto"
        }
    ]
}