{
    "platformAutomerge": true,
    "packageRules": [
        {
            "description": "Automerge Docker image updates",
            "matchDatasources": [
                "docker"
            ],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true,
            "automergeStrategy": "auto"
        },
        {
            "description": "Automerge GitHub Actions digest updates",
            "matchManagers": [
                "github-actions"
            ],
            "automerge": true,
            "automergeType": "pr",
            "platformAutomerge": true,
            "automergeStrategy": "auto"
        }
    ]
}